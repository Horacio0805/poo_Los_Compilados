
from control_acceso import ControlAcceso


# Clase intermedia para administrar las credenciales
class AccesoCredencial(ControlAcceso):

    def __init__(self, usuario, codigo):
        super().__init__(usuario)
        self._codigo = str(codigo).strip().upper()

    def validar_resultado(self, valido):

        if hasattr(self, "registrar_intento"):
            self.registrar_intento(valido)
        else:
            self.acceso_permitido = valido

        return self.acceso_permitido


# Primera subclase: acceso mediante PIN
class AccesoPIN(AccesoCredencial):

    PIN_VALIDO = "1234"

    def __init__(self, usuario, pin):
        super().__init__(usuario, pin)

    def verificar_acceso(self):

        if not self._codigo:
            print("Error: no se ingreso un PIN.")
            return self.validar_resultado(False)

        if not self._codigo.isdigit():
            print("Error: el PIN debe contener solo numeros.")
            return self.validar_resultado(False)

        if len(self._codigo) != 4:
            print("Error: el PIN debe tener 4 digitos.")
            return self.validar_resultado(False)

        return self.validar_resultado(
            self._codigo == self.PIN_VALIDO
        )


# Segunda subclase: acceso mediante RFID
class AccesoRFID(AccesoCredencial):

    TARJETAS_VALIDAS = {
        "RFID001",
        "RFID002",
        "RFID003"
    }

    def __init__(self, usuario, tarjeta):
        super().__init__(usuario, tarjeta)

    def verificar_acceso(self):

        if not self._codigo:
            print("Error: no se ingreso un codigo RFID.")
            return self.validar_resultado(False)

        if not self._codigo.startswith("RFID"):
            print("Error: formato de tarjeta no valido.")
            return self.validar_resultado(False)

        return self.validar_resultado(
            self._codigo in self.TARJETAS_VALIDAS
        )


